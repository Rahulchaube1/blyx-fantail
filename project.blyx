use std::cli;
use console;
use fantail;

fn main() {
    let argv = cli_args();
    let count = args_len(argv);
    if count == 1 && args_at(argv, 0) == "--help" {
        println!("Resolve a layered setting and report where an invalid override came from.");
        println!("Usage: fantail values present fallback minimum maximum");
        println!("Vector arguments are comma-separated; use [] for an empty vector.");
        return;
    }
    let mut result = [];
    if count == 0 {
        result = fantail_setting([2, 15, 0], [1, 1, 0], 5.0, 0.0, 10.0);
    } else {
        if count != 5 { stderr_line("Wrong argument count. Use --help."); process_exit(2); }
        let values = console_vector(args_at(argv, 0));
        let present = console_vector(args_at(argv, 1));
        let fallback = console_value(args_at(argv, 2));
        let minimum = console_value(args_at(argv, 3));
        let maximum = console_value(args_at(argv, 4));
        result = fantail_setting(values, present, fallback, minimum, maximum);
    }
    if len(result) == 0 { stderr_line("Invalid input for Fantail. See the package input contract."); process_exit(1); }
    let mut i = 0;
    while i < len(result) {
        println!(at(result, i));
        i += 1;
    }
}
